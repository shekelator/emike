# Copy this file to .env and set your credentials.

# AWS credentials for Amazon Nova Sonic via Bedrock.
# Used by the SDK's EnvironmentCredentialsResolver — standard environment
# variable names, nothing Bedrock-specific beyond the region.
AWS_ACCESS_KEY_ID=replace-with-real-access-key
AWS_SECRET_ACCESS_KEY=replace-with-real-secret-key
# Optional temporary-credential session token.
AWS_SESSION_TOKEN=

# Optional: only needed if the config lives in a different region than the
# key defaults to; otherwise omit and rely on sonic.aws_region in config.yaml.
# AWS_DEFAULT_REGION=us-east-1

# Primary search provider key (optional, for the web_search tool).
FIRECRAWL_API_KEY=replace-with-real-api-key
# Optional but recommended for higher-quality web search results.
BRAVE_API_KEY=replace-with-real-api-key
